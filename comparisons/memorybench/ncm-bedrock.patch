index 0000000..deceaa0
--- /dev/null
+++ b/src/providers/ncm/prompts.ts
@@ -0,0 +1,78 @@
+import type { ProviderPrompts } from "../../types/prompts"
+
+interface NCMSearchResult {
+  content: string
+  speaker: string
+  sessionId: string
+  date?: string | null
+  time: number
+  rank: number
+  score: number
+}
+
+/** Retrieved turns, oldest first and grouped by session, so the latest version of a changed fact is read last. */
+function buildNCMContext(context: unknown[]): string {
+  const results = (context as NCMSearchResult[]).slice().sort((a, b) => a.time - b.time || a.rank - b.rank)
+  if (results.length === 0) {
+    return "No relevant memories were retrieved."
+  }
+
+  const blocks: string[] = []
+  let current = ""
+  let lines: string[] = []
+  for (const r of results) {
+    if (r.sessionId !== current) {
+      if (lines.length) blocks.push(lines.join("\n"))
+      current = r.sessionId
+      const date = r.date ? ` | Date: ${r.date}` : ""
+      lines = [`(session: ${r.sessionId}${date})`]
+    }
+    lines.push(`${r.speaker}: ${r.content}`)
+  }
+  if (lines.length) blocks.push(lines.join("\n"))
+  return blocks.join("\n\n---\n\n")
+}
+
+export function buildNCMAnswerPrompt(question: string, context: unknown[], questionDate?: string): string {
+  const retrievedContext = buildNCMContext(context)
+
+  return `You are a question-answering system. Based on the retrieved memories below, answer the question.
+
+Question: ${question}
+Question Date: ${questionDate || "Not specified"}
+
+Retrieved Memories (conversation turns, oldest first, grouped by session):
+${retrievedContext}
+
+**Understanding the Context:**
+The context contains the conversation turns most relevant to the question, retrieved by a memory system and shown verbatim (speaker: what they said), not summaries.
+
+- **Date** indicates when that conversation took place
+- Turns under the same session header are from the same conversation, in order
+- Sessions are in chronological order, so later sessions are more recent
+
+**How to Answer:**
+1. Look for the turns that directly answer the question
+2. Look for specific facts, names, dates, preferences, and relationships in what the speakers said
+3. Cross-reference information across turns from the same or different sessions
+4. For temporal questions, use the session dates and any date references within the turns
+5. If a fact changed over time, prefer the most recent statement
+
+Instructions:
+- Base your answer ONLY on the provided memories
+- If the memories contain enough information, provide a clear, concise answer
+- If the memories do not contain enough information, respond with "I don't know"
+- Pay attention to temporal context for time-based questions
+
+Reasoning:
+[Your step-by-step reasoning process here]
+
+Answer:
+[Your final answer here]`
+}
+
+export const NCM_PROMPTS: ProviderPrompts = {
+  answerPrompt: buildNCMAnswerPrompt,
+}
+
+export default NCM_PROMPTS
