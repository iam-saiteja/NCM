diff --git a/src/utils/disk-cache.ts b/src/utils/disk-cache.ts
new file mode 100644
index 0000000..329e637
--- /dev/null
+++ b/src/utils/disk-cache.ts
@@ -0,0 +1,47 @@
+import { createHash } from "crypto"
+import { existsSync, readFileSync, appendFileSync, mkdirSync } from "fs"
+import { dirname } from "path"
+
+/**
+ * Memoises an async function by key, optionally persisted as JSON lines. Benchmarks ingest
+ * the same session once per question (LoCoMo: ~2,000 times for 272 sessions); with a
+ * deterministic model the result is the same each time, so it is computed once.
+ * Concurrent requests for one key share a single call.
+ */
+export class AsyncCache<T> {
+  private mem = new Map<string, Promise<T>>()
+
+  constructor(private file?: string) {
+    if (!file) return
+    if (existsSync(file)) {
+      for (const line of readFileSync(file, "utf8").split("\n")) {
+        if (!line) continue
+        try {
+          const { k, v } = JSON.parse(line)
+          this.mem.set(k, Promise.resolve(v))
+        } catch {
+          // a line cut short by a crash: recompute it
+        }
+      }
+    } else {
+      mkdirSync(dirname(file), { recursive: true })
+    }
+  }
+
+  static key(...parts: string[]): string {
+    return createHash("sha256").update(parts.join("\u0000")).digest("hex")
+  }
+
+  get(key: string, make: () => Promise<T>): Promise<T> {
+    let p = this.mem.get(key)
+    if (!p) {
+      p = make().then((v) => {
+        if (this.file) appendFileSync(this.file, JSON.stringify({ k: key, v }) + "\n")
+        return v
+      })
+      p.catch(() => this.mem.delete(key))
+      this.mem.set(key, p)
+    }
+    return p
+  }
+}
