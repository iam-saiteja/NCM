@@ -0,0 +1,139 @@
+import { createOpenAICompatible } from "@ai-sdk/openai-compatible"
+import { mkdirSync, writeFileSync } from "fs"
+
+/**
+ * Amazon Bedrock through its OpenAI-compatible endpoint, authenticated with a Bedrock API key.
+ *
+ * gpt-oss models on Bedrock return their reasoning inline as <reasoning>...</reasoning> at the
+ * start of the message content; it is stripped here so answers and judge verdicts are clean.
+ * A max_tokens default is added because the reasoning counts against it.
+ */
+
+export const BEDROCK_REGION = process.env.BEDROCK_REGION || "ap-southeast-2"
+export const BEDROCK_API_KEY = process.env.BEDROCK_API_KEY || ""
+
+const DEFAULT_MAX_TOKENS = 4096
+
+export const bedrockEmbeddingTokens = { count: 0 }
+
+/** At most this many Bedrock chat requests (and, separately, embedding requests) in flight. */
+const MAX_IN_FLIGHT = parseInt(process.env.BEDROCK_MAX_IN_FLIGHT || "32", 10)
+const MAX_EMBEDDINGS_IN_FLIGHT = parseInt(process.env.BEDROCK_MAX_EMBEDDINGS_IN_FLIGHT || "8", 10)
+
+type Pool = <T>(fn: () => Promise<T>) => Promise<T>
+
+function pool(size: number): Pool {
+  let inFlight = 0
+  const waiting: Array<() => void> = []
+  return async function <T>(fn: () => Promise<T>): Promise<T> {
+    if (inFlight >= size) await new Promise<void>((r) => waiting.push(r))
+    inFlight++
+    try {
+      return await fn()
+    } finally {
+      inFlight--
+      waiting.shift()?.()
+    }
+  }
+}
+const slot = pool(MAX_IN_FLIGHT)
+const embeddingSlot = pool(MAX_EMBEDDINGS_IN_FLIGHT)
+
+/**
+ * fetch, retried on server errors and network failures (timeouts, resets) up to 8 times;
+ * throttling (429) is waited out for up to ~30 minutes.
+ */
+async function retryingFetch(input: RequestInfo | URL, init?: RequestInit, through: Pool = slot): Promise<Response> {
+  for (let attempt = 0, throttled = 0; ; attempt++) {
+    let response: Response | null = null
+    try {
+      response = await through(() => fetch(input, init))
+    } catch (e) {
+      if (attempt >= 8) throw e
+    }
+    if (response?.status === 429 && throttled++ < 60) {
+      attempt = Math.min(attempt, 4)
+    } else if (response && (response.status < 500 || attempt >= 8)) {
+      return response
+    }
+    await new Promise((r) => setTimeout(r, Math.min(30_000, 2_000 * 2 ** attempt) * (0.5 + Math.random())))
+  }
+}
+
+const REASONING = /<reasoning>[\s\S]*?<\/reasoning>/g
+
+/** Token counts per model for this process, written to data/usage/ so a run's cost can be checked. */
+export const bedrockUsage: Record<string, { calls: number; inputTokens: number; outputTokens: number }> = {}
+const USAGE_FILE = `data/usage/bedrock-${new Date().toISOString().replace(/[:.]/g, "-")}-${process.pid}.json`
+let usageWrites = 0
+function writeUsage(force = false) {
+  if (!force && ++usageWrites % 25 !== 0) return
+  mkdirSync("data/usage", { recursive: true })
+  writeFileSync(
+    USAGE_FILE,
+    JSON.stringify({ argv: process.argv.slice(2), usage: bedrockUsage, embeddingTokens: bedrockEmbeddingTokens.count }, null, 1)
+  )
+}
+process.on("exit", () => {
+  if (Object.keys(bedrockUsage).length || bedrockEmbeddingTokens.count) writeUsage(true)
+})
+
+async function bedrockFetch(input: RequestInfo | URL, init?: RequestInit): Promise<Response> {
+  if (init?.body && typeof init.body === "string") {
+    const body = JSON.parse(init.body)
+    if (body.max_tokens === undefined && body.max_completion_tokens === undefined) {
+      body.max_tokens = DEFAULT_MAX_TOKENS
+    }
+    init = { ...init, body: JSON.stringify(body) }
+  }
+
+  const response = await retryingFetch(input, init)
+  if (!response.ok) return response
+
+  const data = await response.json()
+  for (const choice of data.choices || []) {
+    const content = choice.message?.content
+    if (typeof content === "string") {
+      choice.message.content = content.replace(REASONING, "").trim()
+    }
+  }
+  const u = (bedrockUsage[data.model || "unknown"] ||= { calls: 0, inputTokens: 0, outputTokens: 0 })
+  u.calls += 1
+  u.inputTokens += data.usage?.prompt_tokens || 0
+  u.outputTokens += data.usage?.completion_tokens || 0
+  writeUsage()
+
+  return new Response(JSON.stringify(data), {
+    status: response.status,
+    headers: { "content-type": "application/json" },
+  })
+}
+
+export function createBedrock(apiKey: string = BEDROCK_API_KEY) {
+  if (!apiKey) throw new Error("BEDROCK_API_KEY is not set")
+  return createOpenAICompatible({
+    name: "bedrock",
+    baseURL: `https://bedrock-runtime.${BEDROCK_REGION}.amazonaws.com/openai/v1`,
+    apiKey,
+    fetch: bedrockFetch as typeof fetch,
+  })
+}
+
+/** Titan Text Embeddings v2 (1024 dims, normalised): Bedrock's counterpart to text-embedding-3-small. */
+export const BEDROCK_EMBEDDING_MODEL = "amazon.titan-embed-text-v2:0"
+
+export async function bedrockEmbed(text: string, apiKey: string = BEDROCK_API_KEY): Promise<number[]> {
+  const url = `https://bedrock-runtime.${BEDROCK_REGION}.amazonaws.com/model/${encodeURIComponent(BEDROCK_EMBEDDING_MODEL)}/invoke`
+  const body = JSON.stringify({ inputText: text.slice(0, 40_000), dimensions: 1024, normalize: true })
+  const response = await retryingFetch(
+    url,
+    { method: "POST", headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" }, body },
+    embeddingSlot
+  )
+  if (!response.ok) throw new Error(`Bedrock embedding failed: ${response.status} ${await response.text()}`)
+  const data = (await response.json()) as { embedding: number[]; inputTextTokenCount?: number }
+  bedrockEmbeddingTokens.count += data.inputTextTokenCount || 0
+  writeUsage()
+  return data.embedding
+}
+
