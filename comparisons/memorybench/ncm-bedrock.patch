diff --git a/src/providers/ncm/index.ts b/src/providers/ncm/index.ts
new file mode 100644
index 0000000..bbd1abb
--- /dev/null
+++ b/src/providers/ncm/index.ts
@@ -0,0 +1,94 @@
+import type {
+  Provider,
+  ProviderConfig,
+  IngestOptions,
+  IngestResult,
+  SearchOptions,
+  IndexingProgressCallback,
+} from "../../types/provider"
+import type { UnifiedSession } from "../../types/unified"
+import { logger } from "../../utils/logger"
+import { NCM_PROMPTS } from "./prompts"
+
+/**
+ * NCM (Neural Context Memory), run locally through a small HTTP bridge
+ * (comparisons/memorybench_bridge.py in the NCM repository).
+ *
+ * - Ingestion: every message is stored as one memory (no LLM extraction), with the
+ *   session's date and the speaker. Two-person transcripts (LoCoMo, where messages carry
+ *   speaker names) use NCM's dialogue mode; user/assistant chats use the default.
+ * - Search: NCM's ranking (dense + BM25 + session context), returning the best
+ *   `NCM_TURNS_PER_RESULT x limit` single turns, since one turn is much shorter than a
+ *   RAG chunk (default 3 x 10 = 30 turns).
+ */
+export class NCMProvider implements Provider {
+  name = "ncm"
+  prompts = NCM_PROMPTS
+  concurrency = {
+    default: 16,
+    ingest: 8,
+  }
+
+  private baseUrl = "http://127.0.0.1:8765"
+  private turnsPerResult = parseInt(process.env.NCM_TURNS_PER_RESULT || "3", 10)
+
+  async initialize(config: ProviderConfig): Promise<void> {
+    this.baseUrl = config.baseUrl || this.baseUrl
+    const health = await this.call("health", {})
+    logger.info(`Initialized NCM provider via ${this.baseUrl} (${JSON.stringify(health)})`)
+  }
+
+  private async call(path: string, body: unknown): Promise<any> {
+    for (let attempt = 0; ; attempt++) {
+      try {
+        const response = await fetch(`${this.baseUrl}/${path}`, {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(body),
+        })
+        if (!response.ok) throw new Error(`NCM bridge ${path}: ${response.status} ${await response.text()}`)
+        return await response.json()
+      } catch (e) {
+        if (attempt >= 10) throw e
+        await new Promise((r) => setTimeout(r, Math.min(30_000, 1000 * 2 ** attempt)))
+      }
+    }
+  }
+
+  async ingest(sessions: UnifiedSession[], options: IngestOptions): Promise<IngestResult> {
+    const payload = sessions.map((s) => ({
+      sessionId: s.sessionId,
+      date: (s.metadata?.date as string) || null,
+      messages: s.messages.map((m) => ({
+        speaker: m.speaker || m.role,
+        content: m.content,
+        timestamp: m.timestamp || null,
+      })),
+      dialogue: s.messages.some((m) => !!m.speaker),
+    }))
+    await this.call("ingest", { tag: options.containerTag, sessions: payload })
+    // one id per session, not per stored turn: MemoryBench keeps every id in its checkpoint
+    return { documentIds: sessions.map((s) => s.sessionId) }
+  }
+
+  async awaitIndexing(
+    result: IngestResult,
+    _containerTag: string,
+    onProgress?: IndexingProgressCallback
+  ): Promise<void> {
+    // NCM indexes synchronously during ingest
+    onProgress?.({ completedIds: result.documentIds, failedIds: [], total: result.documentIds.length })
+  }
+
+  async search(query: string, options: SearchOptions): Promise<unknown[]> {
+    const k = (options.limit || 10) * this.turnsPerResult
+    const out = await this.call("search", { tag: options.containerTag, query, k })
+    return out.results
+  }
+
+  async clear(containerTag: string): Promise<void> {
+    await this.call("clear", { tag: containerTag })
+  }
+}
+
+export default NCMProvider
